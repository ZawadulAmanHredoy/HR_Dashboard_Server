# ----------------------------------------------------------------- Express
# Production API domain (Coolify). In dev you may use 3000 locally — just keep
# it in sync with GOOGLE_REDIRECT_URI and CLIENT_ORIGIN below.
PORT=4000

# Where the browser has the UI open — used for CORS and for the post-login
# redirect. Two setups:
#   production:                https://hr.aicareeradvisor.io
#   two servers (npm run dev): http://localhost:5173   (Vite serves the UI)
#   one server  (npm run serve): http://localhost:3000  (Express serves client/dist)
#   migrating http -> https: list both, comma-separated. The FIRST origin is
#   canonical and receives the post-login redirect.
CLIENT_ORIGIN=https://hr.aicareeradvisor.io

# ------------------------------------------------------- Google OAuth client
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). GOOGLE_REDIRECT_URI must be registered there verbatim
# under "Authorised redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.hr.aicareeradvisor.io/api/auth/callback

# --------------------------------------------------------------- Session/JWT
# Signs the httpOnly session cookie issued after Google sign-in. Use a long
# random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Left blank, the server generates one per boot and sessions end on restart.
SESSION_SECRET=
SESSION_COOKIE_NAME=aicv_session
SESSION_MAX_AGE_DAYS=7

# true  -> reject every request without a valid session
# false -> before Google credentials exist, run as the demo consultant so the UI works
AUTH_REQUIRED=false

# ---------------------------------------------------------------- Supabase
# Database only — Supabase Auth is not used. Project settings -> API.
# The service role key is SERVER ONLY; never expose it to the browser.
# Leave blank to run the API on in-memory seed data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional read-only fallback if you have no service role key (subject to RLS).
SUPABASE_ANON_KEY=
